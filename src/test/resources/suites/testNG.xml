<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Atlas MCHS Tests" parallel="tests" thread-count="3">

    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="ru.mchs.atlas.tests.MapGeneralTests"/>
            <class name="ru.mchs.atlas.tests.MapLayerTests"/>
            <class name="ru.mchs.atlas.tests.RouteAndSearchTests"/>
            <class name="ru.mchs.atlas.tests.ContextMenuTests"/>
        </classes>
    </test>

    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="ru.mchs.atlas.tests.MapGeneralTests"/>
            <class name="ru.mchs.atlas.tests.MapLayerTests"/>
            <class name="ru.mchs.atlas.tests.RouteAndSearchTests"/>
            <class name="ru.mchs.atlas.tests.ContextMenuTests"/>
        </classes>
    </test>

</suite>